# Keycloak — только хост Keycloak, не API.
# Keycloak на 8180. Бэкенд: локально часто http://localhost:8090, в k8s/Tilt — :8080 (infra/README.md).
# Если здесь указать порт API, запросы к /realms/... дадут 400.
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=aggro
VITE_KEYCLOAK_CLIENT_ID=aggro-frontend

# Режим: check-sso | login-required
VITE_KEYCLOAK_ONLOAD=check-sso

# HTTP API бэка (Bearer из Keycloak)
VITE_API_BASE_URL=http://localhost:8090
